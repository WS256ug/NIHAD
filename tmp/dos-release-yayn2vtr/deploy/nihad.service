[Unit]
Description=NIHAD Django school management
After=network.target

[Service]
User=nihad
Group=nihad
WorkingDirectory=/srv/nihad
EnvironmentFile=/etc/nihad.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/srv/nihad/.venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 3 --timeout 60 config.wsgi:application
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nihad
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
