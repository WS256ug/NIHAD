# Copy to .env, then replace this value with a randomly generated secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Africa/Nairobi

# manage.py defaults to development (SQLite). For production, set the process
# environment variable DJANGO_SETTINGS_MODULE=config.settings.production.
# Set production hosts and HTTPS origins before using production settings.
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=school_management
POSTGRES_USER=school_management
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Use verify-full with a trusted certificate where your database supports it.
POSTGRES_SSLMODE=require
