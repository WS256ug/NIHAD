# Copy to .env, then replace this value with a randomly generated secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Africa/Nairobi

# manage.py defaults to development (SQLite). For production, set the process
# environment variable DJANGO_SETTINGS_MODULE=config.settings.production.
# Set production hosts and HTTPS origins before using production settings.
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=school_management
POSTGRES_USER=school_management
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Use verify-full with a trusted certificate where your database supports it.
POSTGRES_SSLMODE=require

# Password reset: development prints emails to the server console.
# Production uses SMTP. Configure these before enabling password recovery there.
DEFAULT_FROM_EMAIL=NIHAD School <noreply@localhost>
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Optional local SQLite override, useful for isolated demos/tests.
# SQLITE_DB_PATH=E:/Projects/NIHAD/artifacts/demo.sqlite3

# Production private data and backups must stay outside public static/media URLs.
# DJANGO_PRIVATE_MEDIA_ROOT=/var/lib/nihad/private_media
# DJANGO_MEDIA_ROOT=/var/lib/nihad/media
# DJANGO_BACKUP_ROOT=/var/backups/nihad
# POSTGRES_BIN_DIR=/usr/bin

# Enable only when a trusted reverse proxy overwrites X-Forwarded-Proto and
# X-Real-IP, and the application port cannot be reached directly from the Internet.
DJANGO_BEHIND_HTTPS_PROXY=false
AUTH_TRUSTED_PROXIES=
LOGIN_FAILURE_LIMIT=5
AUTH_IP_FAILURE_LIMIT=100
AUTH_WINDOW_SECONDS=900
RESET_REQUEST_LIMIT=5
